# ==============================================================================
# FORTIVEX — Environment Configuration Example
# ==============================================================================

# Backend Server Port (defaults to 5000)
PORT=5000

# Optional: GitHub Personal Access Token (Classic or Fine-grained)
# If omitted, FORTIVEX operates in public unauthenticated mode (60 requests/hour).
# Supplying a token increases your rate limit to 5,000 requests/hour.
# Permissions required: None (public read-only).
GITHUB_TOKEN=

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Configuration (MongoDB Atlas for User Auth & Persistent Storage)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fortivex?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for Session Signing
JWT_SECRET=your_jwt_secret_key_here
